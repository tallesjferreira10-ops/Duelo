
const http = require("http");
const WebSocket = require("ws");

const PORT = process.env.PORT || 3000;
const MAX_PLAYERS = 4;
const rooms = new Map();

function createCode() {
  const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  let code;
  do {
    code = Array.from({ length: 6 }, () =>
      chars[Math.floor(Math.random() * chars.length)]
    ).join("");
  } while (rooms.has(code));
  return code;
}

function send(ws, data) {
  if (ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify(data));
  }
}

function broadcast(room, data, except = null) {
  room.players.forEach(player => {
    if (player.ws !== except) send(player.ws, data);
  });
}

const server = http.createServer((req, res) => {
  if (req.url === "/" || req.url === "/health") {
    res.writeHead(200, {
      "Content-Type": "application/json"
    });
    return res.end(JSON.stringify({
      ok: true,
      service: "Duelo 3D",
      rooms: rooms.size
    }));
  }

  res.writeHead(404);
  res.end("Not found");
});

const wss = new WebSocket.Server({ server });

function leaveRoom(ws) {
  const code = ws.roomCode;
  if (!code) return;

  ws.roomCode = null;
  const room = rooms.get(code);
  if (!room) return;

  room.players = room.players.filter(p => p.ws !== ws);

  if (room.players.length === 0) {
    rooms.delete(code);
  } else {
    broadcast(room, {
      type: "player_left",
      players: room.players.length
    });
  }
}

wss.on("connection", ws => {
  ws.roomCode = null;
  ws.playerId = null;

  send(ws, {
    type: "connected",
    message: "Conectado ao Duelo 3D"
  });

  ws.on("message", raw => {
    let msg;

    try {
      msg = JSON.parse(raw.toString());
    } catch {
      return send(ws, {
        type: "error",
        message: "Mensagem inválida"
      });
    }

    if (msg.action === "create_room") {
      const code = createCode();
      const player = {
        id: String(msg.playerId || Date.now()),
        name: String(msg.name || "Jogador").slice(0, 20),
        ws
      };

      const room = {
        code,
        mode: ["teams", "battle", "headshot"].includes(msg.mode)
          ? msg.mode : "teams",
        players: [player]
      };

      rooms.set(code, room);
      ws.roomCode = code;
      ws.playerId = player.id;

      return send(ws, {
        type: "room_created",
        roomCode: code,
        mode: room.mode,
        players: 1,
        maxPlayers: MAX_PLAYERS
      });
    }

    if (msg.action === "join_room") {
      const code = String(msg.roomCode || "").trim().toUpperCase();
      const room = rooms.get(code);

      if (!room) {
        return send(ws, {
          type: "error",
          message: "Sala não encontrada"
        });
      }

      if (room.players.length >= MAX_PLAYERS) {
        return send(ws, {
          type: "error",
          message: "Sala cheia"
        });
      }

      const player = {
        id: String(msg.playerId || Date.now()),
        name: String(msg.name || "Jogador").slice(0, 20),
        ws
      };

      room.players.push(player);
      ws.roomCode = code;
      ws.playerId = player.id;

      send(ws, {
        type: "room_joined",
        roomCode: code,
        mode: room.mode,
        players: room.players.length,
        maxPlayers: MAX_PLAYERS
      });

      broadcast(room, {
        type: "player_joined",
        players: room.players.length,
        player: {
          id: player.id,
          name: player.name
        }
      }, ws);

      return;
    }

    if (msg.action === "game_event") {
      const room = rooms.get(ws.roomCode);
      if (!room) {
        return send(ws, {
          type: "error",
          message: "Você não está em uma sala"
        });
      }

      broadcast(room, {
        type: "game_event",
        playerId: ws.playerId,
        event: msg.event
      }, ws);

      return;
    }

    if (msg.action === "leave_room") {
      leaveRoom(ws);
      return send(ws, { type: "left_room" });
    }

    send(ws, {
      type: "error",
      message: "Ação desconhecida"
    });
  });

  ws.on("close", () => leaveRoom(ws));
  ws.on("error", () => leaveRoom(ws));
});

const heartbeat = setInterval(() => {
  wss.clients.forEach(ws => {
    if (ws.isAlive === false) {
      return ws.terminate();
    }
    ws.isAlive = false;
    ws.ping();
  });
}, 30000);

wss.on("connection", ws => {
  ws.isAlive = true;
  ws.on("pong", () => {
    ws.isAlive = true;
  });
});

server.listen(PORT, () => {
  console.log("Duelo 3D rodando na porta " + PORT);
});

server.on("close", () => clearInterval(heartbeat));
