{
  "name": "duelo3d-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de salas online do Duelo 3D",
  "main": "server.js",
  "scripts": { "start": "node server.js" },
  "engines": { "node": ">=18" },
  "dependencies": { "ws": "^8.18.0" }
}

const http = require('http');
const WebSocket = require('ws');

const PORT = process.env.PORT || 3000;
const rooms = new Map();
const MAX_PLAYERS = 4;
const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

function makeCode() {
  let code;
  do {
    code = Array.from({ length: 6 }, () =>
      alphabet[Math.floor(Math.random() * alphabet.length)]
    ).join('');
  } while (rooms.has(code));
  return code;
}

const server = http.createServer((req, res) => {
  res.setHeader('Content-Type', 'application/json; charset=utf-8');
  if (req.url === '/health' || req.url === '/') {
    res.writeHead(200);
    return res.end(JSON.stringify({
      ok: true,
      service: 'Duelo 3D',
      rooms: rooms.size
    }));
  }
  res.writeHead(404);
  res.end(JSON.stringify({ ok: false, error: 'Not found' }));
});

const wss = new WebSocket.Server({ server });

function send(ws, data) {
  if (ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify(data));
  }
}

function broadcast(room, data, except) {
  for (const player of room.players) {
    if (player !== except) send(player, data);
  }
}

function leave(ws) {
  if (!ws.roomCode) return;
  const room = rooms.get(ws.roomCode);
  if (room) {
    room.players = room.players.filter(p => p !== ws);
    broadcast(room, {
      type: 'player_left',
      playerId: ws.playerId,
      players: room.players.length
    });
    if (room.players.length === 0) rooms.delete(ws.roomCode);
  }
  ws.roomCode = null;
}

wss.on('connection', ws => {
  ws.playerId = Math.random().toString(36).slice(2, 10);
  ws.isAlive = true;
  ws.on('pong', () => { ws.isAlive = true; });

  ws.on('message', raw => {
    let msg;
    try {
      msg = JSON.parse(raw.toString());
    } catch {
      return send(ws, { type: 'error', message: 'Mensagem inválida' });
    }

    if (msg.action === 'create_room') {
      leave(ws);
      const code = makeCode();
      const room = {
        code,
        mode: ['teams', 'battle', 'headshot'].includes(msg.mode)
          ? msg.mode : 'battle',
        players: [ws]
      };
      rooms.set(code, room);
      ws.roomCode = code;
      return send(ws, {
        type: 'room_created',
        roomCode: code,
        playerId: ws.playerId,
        players: 1,
        mode: room.mode
      });
    }

    if (msg.action === 'join_room') {
      leave(ws);
      const code = String(msg.roomCode || '').toUpperCase().trim();
      const room = rooms.get(code);
      if (!room) return send(ws, {
        type: 'error',
        message: 'Sala não encontrada'
      });
      if (room.players.length >= MAX_PLAYERS) return send(ws, {
        type: 'error',
        message: 'Sala cheia'
      });
      room.players.push(ws);
      ws.roomCode = code;
      send(ws, {
        type: 'room_joined',
        roomCode: code,
        playerId: ws.playerId,
        players: room.players.length,
        mode: room.mode
      });
      broadcast(room, {
        type: 'player_joined',
        playerId: ws.playerId,
        players: room.players.length
      }, ws);
      return;
    }

    if (msg.action === 'game_event') {
      const room = rooms.get(ws.roomCode);
      if (room) broadcast(room, {
        type: 'game_event',
        playerId: ws.playerId,
        event: msg.event
      }, ws);
      return;
    }

    if (msg.action === 'leave_room') leave(ws);
  });

  ws.on('close', () => leave(ws));
  ws.on('error', () => leave(ws));
});

const heartbeat = setInterval(() => {
  for (const ws of wss.clients) {
    if (!ws.isAlive) {
      ws.terminate();
      continue;
    }
    ws.isAlive = false;
    ws.ping();
  }
}, 30000);

wss.on('close', () => clearInterval(heartbeat));

server.listen(PORT, '0.0.0.0', () => {
  console.log(`Duelo 3D server listening on ${PORT}`);
});

